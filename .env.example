# Blade Models API (hosted OpenAI-compatible endpoint)
# Create a key at https://console.blade.sh/
BLADE_API_KEY=
BLADE_BASE_URL=https://api.models.blade.sh/v1
BLADE_MODEL=qwen3.6-35b-a3b

# OVHcloud AI Endpoints (managed OpenAI-compatible API)
# Public Cloud > AI & Machine Learning > AI Endpoints > API key
OVH_AI_ENDPOINTS_ACCESS_TOKEN=
# Aliases also supported: OVHAI_ENDPOINT_KEY, OVHAI_ENDPOINT_BASE_URL, OVHAI_ENDPOINT_MODEL
OVH_AI_ENDPOINTS_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
OVH_AI_ENDPOINTS_MODEL=gpt-oss-120b

# OVHcloud AI Deploy (your Docker / vLLM app on GPU — not AI Endpoints)
# Token from AI Dashboard > Tokens (reader = call app URL, operator = ovhai app list)
OVHAI_DEPLOY_TOKEN=
# After you deploy: https://<app-uuid>.app.gra.ai.cloud.ovh.net
OVHAI_DEPLOY_APP_URL=

# OVH AI Deploy — vLLM on L4 (scale to zero); see deploy/ovh-vllm-l4-scale-zero.sh
# OVHAI_VLLM_APP_ID=
# OVHAI_VLLM_FLAVOR=l4-1-gpu
# OVHAI_VLLM_IMAGE=vllm/vllm-openai:latest
# OVHAI_VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# OVHAI_VLLM_COOLDOWN_SECONDS=120
# HF_TOKEN=

# Optional: self-hosted vLLM on Blade AI Fabric (after `blade deploy`)
# FABRIC_TOKEN=
# VLLM_ENDPOINT_URL=
# VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# HF_TOKEN=
